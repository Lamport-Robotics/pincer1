RPC_URL=https://peaq-agung.api.onfinality.io/public
CHAIN_ID=9990
UNITS_CONTRACT=0x…                 # Pincer1Units on that chain
ATTESTER_KEY=0x…                   # Pincer1Units.attester; holds the PEAQ that funds new robots
FUND_WEI=500000000000000000        # a fresh robot address is topped up to this (agung: 0.4 bond + gas)
SERIALS_FILE=./serials.json        # {"P1-0001":{},"P1-0002":{}} the units we built; omit with ALLOW_ANY_SERIAL=true on a bench
STATE_FILE=./activations.json      # serial → key bindings, written by the service
ALLOW_ANY_SERIAL=false
PORT=7430
BIND=127.0.0.1
