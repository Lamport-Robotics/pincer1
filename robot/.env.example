# Copy to .env next to where you launch pincer-robot. No value here is a real secret.

# ElevenLabs TTS (conventional names, no PINCER_ prefix). Leave unset to fall back to espeak-ng / print.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Compute: auto = CUDA when onnxruntime/torch/ctranslate2 see a GPU (Jetson), else CPU (Pi, laptop).
# Model defaults follow the device (buffalo_l / whisper small float16 on cuda, buffalo_sc / base int8 on cpu);
# set PINCER_FACE_MODEL / PINCER_WHISPER_MODEL / PINCER_WHISPER_COMPUTE_TYPE to override.
PINCER_DEVICE=auto

# Companion brain for the optional `chat` request: none | anthropic | local
PINCER_BRAIN=none
PINCER_BRAIN_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
PINCER_LOCAL_URL=http://127.0.0.1:8080/v1
PINCER_LOCAL_MODEL=default

# Identity / enrolment
PINCER_OWNER_NAME=owner
PINCER_ENROL_PATH=~/.pincer1/enrol.json

# Daemon link (PROTOCOL.md section 2)
PINCER_WS_PORT=7402

# ROS2 topics - verify with `ros2 topic list` on the robot
PINCER_SCAN_TOPIC=/scan
PINCER_IMU_TOPIC=/imu
PINCER_CMD_VEL_TOPIC=/cmd_vel

# Thresholds you are most likely to tune on the real hardware
PINCER_LIDAR_LEARN_S=30
PINCER_SPEAKER_THRESHOLD=0.75
PINCER_OWNER_GRACE_S=5
PINCER_SESSION_TIMEOUT_S=300
PINCER_VOICE_TTL_S=120
PINCER_MOVED_ACCEL_THRESHOLD=3.0
PINCER_TTS_BACKEND=auto

# --- owner-optional features (all off; the daemon's `settings` message switches them at runtime) ---
# PINCER_ROOM_LOCK=0            # publish room_match (lidar fingerprint, or map localisation when a map exists)
# PINCER_ROOM_PATH=~/.pincer1/room.json
# PINCER_TWO_PERSON=0           # publish persons + owners (pincer-enroll --add-person <label>)
# PINCER_AIRGAP=off             # off | strict | night  (relay on BOARD pin 7 powers the USB radio)
# PINCER_AIRGAP_PIN=7
# PINCER_AIRGAP_ACTIVE_HIGH=1   # 0 for active-low relay modules
# PINCER_AIRGAP_GRACE_S=60
# PINCER_WAKE=0                 # accept the daemon's wake-up alarm
# PINCER_WAKE_PAUSE_S=2.0
# PINCER_WAKE_STEP_M=0.20
# PINCER_WAKE_MAX_SECS=120
# --- navigation (slam_toolbox + Nav2 on the robot; MockNav without ROS2) ---
# PINCER_MAPS_DIR=~/.pincer1/maps
# PINCER_ROOMS_PATH=~/.pincer1/rooms.json
# PINCER_NAV_GOAL_TIMEOUT_S=90
# PINCER_NAV_SEARCH_DWELL_S=10
# PINCER_NAV_ROOM_RADIUS_M=2.0
# PINCER_NAV_ROOM_PRIORITY=["bedroom","desk","living"]
# PINCER_NAV_LOCALIZED_COV=0.25

# companion brain: lamport (on-robot Lamport-8B, offline) | claude | openai | deepseek | none
PINCER_BRAIN=none
PINCER_LOCAL_URL=http://127.0.0.1:8080/v1
PINCER_LOCAL_MODEL=lamport-8b
ANTHROPIC_API_KEY=
PINCER_BRAIN_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
PINCER_OPENAI_MODEL=gpt-4o
DEEPSEEK_API_KEY=
PINCER_DEEPSEEK_MODEL=deepseek-chat
