# Pincer1 daemon
PINCER_MODE=dev                 # dev | prod  (prod refuses the software signer and requires presence)
CONTROLLER=sim                  # sim | /dev/ttyACM0
ROBOT_WS=ws://127.0.0.1:7402
BIND=0.0.0.0
PORT=7401
RPC_URL=https://api.mainnet-beta.solana.com
DAILY_LIMIT_SOL=2
ADDRESS_BOOK=                   # comma-separated "label:pubkey" pairs the owner trusts
ORIGIN_ALLOWLIST=https://pump.fun,https://jup.ag
# overnight agent
AGENT_ENABLED=false
AGENT_BUDGET_SOL=1
AGENT_MAX_PER_TRADE_SOL=0.2
AGENT_MAX_OPEN=3
AGENT_STOP_LOSS_PCT=25
AGENT_TAKE_PROFIT_PCT=40
AGENT_QUIET_HOURS=00:00-08:00   # only act, never ask, inside this window
SIGNALS_URL=                    # smart-money signal feed (product name TBD); empty = mock provider

# optional features (all off by default; also editable at runtime via GET/POST /settings → DATA_DIR/settings.json)
ROOM_MATCH_MIN=0.85             # room lock threshold once enabled in settings
TWO_PERSON_SOL=0                # 0 = off; e.g. 5 → transfers ≥ 5 SOL need two enrolled owners in the room
INHERIT_HEIR=                   # dead-man's switch heir (armed via POST /inheritance/arm, timer lives on the controller)
INHERIT_DAYS=90
INHERIT_WARN_DAYS=14,7,1
NOTIFY_WEBHOOK_URL=             # receives inheritance warnings/release and alerts as JSON
NTFY_TOPIC=                     # phone alarm via https://ntfy.sh/<topic> (urgent priority)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OFFLINE_NONCE_ACCOUNT=          # durable-nonce account for offline payments (POST /offline/nonce/create makes one)

# ── multi-chain (one seed in the SE050: ed25519 for Solana, secp256k1 for EVM and Bitcoin) ──
# EVM JSON-RPC per chain id; public defaults exist for 1 (Ethereum), 8453 (Base), 42161 (Arbitrum), 56 (BNB), 137 (Polygon)
EVM_RPC_1=https://cloudflare-eth.com
EVM_RPC_8453=https://mainnet.base.org
EVM_RPC_42161=https://arb1.arbitrum.io/rpc
EVM_RPC_56=https://bsc-dataseed.binance.org
EVM_RPC_137=https://polygon-rpc.com
ETHERSCAN_API_KEY=              # optional: contract creation age + source verification (Etherscan V2, all chains); without it age comes from eth_getCode probes
DAILY_LIMIT_ETH=1               # controller-side daily limit for EVM value, in the chain's native coin
EVM_ROUTER_ALLOWLIST=           # extra router addresses the owner trusts (comma-separated); 1inch v6 and 0x are built in
BTC_NETWORK=mainnet             # mainnet | testnet
BTC_ESPLORA_URL=https://blockstream.info/api   # any Esplora-compatible API (mempool.space, self-hosted electrs); 4 s timeout
BTC_MAX_FEE_RATE=200            # sat/vB cap; fee hints above it are clamped, never trusted
BTC_FEE_TARGET_BLOCKS=3
DAILY_LIMIT_BTC=0.05
# swaps (settings.mode must be "online"; routers are allowlisted, min output re-decoded from the bytes, slippage capped at 1%)
ONEINCH_API_KEY=                # 1inch v6 aggregation API (EVM); falls back to 0x when unset or failing
ZEROX_API_KEY=                  # 0x API (EVM fallback)
THORNODE_URL=https://thornode.ninerealms.com   # cross-chain quotes + inbound addresses (pinned 10 min)
THORNODE_URL_2=https://thornode.thorchain.liquify.com   # second, independent node: an inbound address is pinned only when both agree
SWAP_MAX_SLIPPAGE_BPS=100       # hard cap; settings.swapMaxSlippageBps may lower it
