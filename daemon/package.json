{
  "name": "pincerd",
  "version": "0.1.0",
  "private": true,
  "description": "Pincer1 wallet daemon: parses and explains transactions, runs the scam filter, gates on presence, talks to the consent controller.",
  "type": "module",
  "bin": {
    "pincerd": "dist/main.js"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@solana/spl-token": "0.4.9",
    "@solana/web3.js": "1.95.8",
    "bitcoinjs-lib": "6.1.7",
    "bs58": "6.0.0",
    "qrcode": "1.5.4",
    "serialport": "12.0.0",
    "tweetnacl": "1.0.3",
    "viem": "2.57.4",
    "ws": "8.18.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/ws": "8.5.13",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
