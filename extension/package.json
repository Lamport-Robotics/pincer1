{
  "name": "pincer1-extension",
  "version": "0.2.0",
  "private": true,
  "description": "Pincer1 browser extension — Solana (Wallet Standard), EVM (EIP-1193/6963) and Bitcoin wallets whose keys live on the robot. Signs only after physical consent.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "build": "node scripts/make-icons.mjs && node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/wallet-standard-chains": "1.1.2",
    "@solana/wallet-standard-features": "1.5.0",
    "@solana/web3.js": "1.99.0",
    "@wallet-standard/core": "1.1.2",
    "bs58": "6.0.0",
    "viem": "2.57.4"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "bufferutil",
      "esbuild",
      "utf-8-validate"
    ]
  }
}
