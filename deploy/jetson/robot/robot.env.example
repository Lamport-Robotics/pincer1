# /etc/pincer1/robot.env  (chmod 600, owner pincer). Read by pincer-robot.service.
# Every PINCER_* variable in robot/pincer_robot/config.py can go here; these are the ones that matter on the Jetson.

# Compute: auto picks CUDA when onnxruntime-gpu / torch / ctranslate2 see the Orin GPU, else CPU.
# Model defaults follow the device: buffalo_l + whisper small float16 on cuda, buffalo_sc + base int8 on cpu.
PINCER_DEVICE=auto
#PINCER_FACE_MODEL=buffalo_l
#PINCER_WHISPER_MODEL=small
#PINCER_WHISPER_COMPUTE_TYPE=float16

# Enrolment lives in the service's HOME (/var/lib/pincer1), not in a login user's home.
PINCER_ENROL_PATH=/var/lib/pincer1/.pincer1/enrol.json
PINCER_OWNER_NAME=owner

# Daemon link (PROTOCOL.md section 2); pincerd's ROBOT_WS must match.
PINCER_WS_PORT=7402

# ROS2 topics - verify on the robot: ros2 topic list | grep -iE 'cmd_vel|scan|imu'
PINCER_SCAN_TOPIC=/scan
PINCER_IMU_TOPIC=/imu
PINCER_CMD_VEL_TOPIC=/cmd_vel

# Camera: V4L2 index (USB webcam = 0; a CSI camera through nvarguscamerasrc also appears as /dev/video0 on JetPack 6).
PINCER_CAMERA_INDEX=0
PINCER_CAMERA_FPS=8
# Microphone: leave unset for the ALSA default, or a sounddevice name/index (python -m sounddevice).
#PINCER_MIC_DEVICE=

# Speech: auto = ElevenLabs if the two keys are set, else espeak-ng.
PINCER_TTS_BACKEND=auto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Companion brain for the optional `chat` request: none | anthropic | local
PINCER_BRAIN=none
PINCER_BRAIN_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# local = an OpenAI-compatible server on this box (llama.cpp `llama-server --port 8080` or ollama on :11434/v1)
PINCER_LOCAL_URL=http://127.0.0.1:8080/v1
PINCER_LOCAL_MODEL=default

# Thresholds you are most likely to tune on the real hardware
PINCER_LIDAR_LEARN_S=30
PINCER_SPEAKER_THRESHOLD=0.75
PINCER_OWNER_GRACE_S=5
PINCER_SESSION_TIMEOUT_S=300
PINCER_VOICE_TTL_S=120
PINCER_MOVED_ACCEL_THRESHOLD=3.0
