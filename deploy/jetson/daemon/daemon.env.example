# /etc/pincer1/daemon.env  (chmod 600)
PINCER_MODE=prod
CONTROLLER=/dev/pincer-consent
ROBOT_WS=ws://127.0.0.1:7402
BIND=0.0.0.0
PORT=7401
RPC_URL=https://api.mainnet-beta.solana.com
DAILY_LIMIT_SOL=2
DATA_DIR=/var/lib/pincer1
ADDRESS_BOOK=
ORIGIN_ALLOWLIST=https://pump.fun,https://jup.ag
AGENT_ENABLED=false
LOG_LEVEL=info
