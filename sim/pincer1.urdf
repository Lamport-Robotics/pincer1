  </link>
  <joint name="fl_foot_tip" type="fixed">
    <origin xyz="0.16 0 0" rpy="0 0 0"/>
    <parent link="fl_tibia_link"/>
    <child link="fl_foot"/>
  </joint>

  <!-- arm: yaw, shoulder, elbow, wrist; the camera head rides the wrist -->
  <joint name="arm_yaw" type="revolute">
    <origin xyz="0.06 0 0" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="arm_base_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="3" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="arm_base_link">
    <inertial>
      <origin xyz="0 0 0.0215" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="5.880e-06" ixy="0" ixz="0" iyy="1.218e-05" iyz="0" izz="1.218e-05"/>
