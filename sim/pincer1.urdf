  </link>
  <joint name="fl_tibia" type="revolute">
    <origin xyz="0.11 0 0" rpy="0 0 0"/>
    <parent link="fl_femur_link"/>
    <child link="fl_tibia_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.70526" upper="-0.2618" effort="3" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="fl_tibia_link">
    <inertial>
      <origin xyz="0.074 0 0" rpy="0 1.5708 0"/>
      <mass value="0.045"/>
      <inertia ixx="4.410e-06" ixy="0" ixz="0" iyy="9.821e-05" iyz="0" izz="9.821e-05"/>
