    <limit lower="-2.0944" upper="2.0944" effort="3" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="arm_fore_link">
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
