    </inertial>
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.08"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry><cylinder radius="0.014" length="0.08"/></geometry>
    </collision>
  </link>
  <joint name="arm_wrist" type="revolute">
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
    <parent link="arm_fore_link"/>
    <child link="head"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0944" upper="2.0944" effort="3" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="head">
