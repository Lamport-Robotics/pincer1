  <!-- leg FL -->
  <joint name="fl_coxa" type="revolute">
    <origin xyz="0.083 0.051 0" rpy="0 0 0.7854"/>
    <parent link="body"/>
    <child link="fl_coxa_link"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="0.7854" effort="3" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="fl_coxa_link">
    <inertial>
      <origin xyz="0.0225 0 0" rpy="0 1.5708 0"/>
      <mass value="0.06"/>
      <inertia ixx="5.880e-06" ixy="0" ixz="0" iyy="1.306e-05" iyz="0" izz="1.306e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.0225 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.014" length="0.045"/></geometry>
      <material name="metal"/>
    </visual>
    <collision>
      <origin xyz="0.0225 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.014" length="0.045"/></geometry>
    </collision>
  </link>
  <joint name="fl_femur" type="revolute">
    <origin xyz="0.045 0 0" rpy="0 0 0"/>
    <parent link="fl_coxa_link"/>
    <child link="fl_femur_link"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-1.22173" upper="1.5708" effort="3" velocity="6"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>
  <link name="fl_femur_link">
    <inertial>
      <origin xyz="0.055 0 0" rpy="0 1.5708 0"/>
      <mass value="0.08"/>
      <inertia ixx="7.840e-06" ixy="0" ixz="0" iyy="8.459e-05" iyz="0" izz="8.459e-05"/>
    </inertial>
    <visual>
      <origin xyz="0.055 0 0" rpy="0 1.5708 0"/>
