  <link name="fl_foot">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.006"/>
      <inertia ixx="1.000e-07" ixy="0" ixz="0" iyy="1.000e-07" iyz="0" izz="1.000e-07"/>
